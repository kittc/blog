---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import NoteTimeline from "../_components/NoteTimeline.astro";
import { getSortedNotes } from "@/utils/getSortedNotes";
import { getUniqueTags } from "@/utils/getUniqueTags";
import { slugifyAll } from "@/utils/slugify";
import { useTranslations } from "@/i18n";
import config from "@/config";

export async function getStaticPaths() {
  if (!config.features.showNotes) return [];

  const notes = getSortedNotes(await getCollection("notes"));

  return getUniqueTags(notes).map(({ tag, tagName }) => ({
    params: { tag },
    props: {
      tagName,
      notes: notes.filter(note => slugifyAll(note.data.tags).includes(tag)),
    },
  }));
}

const { tagName, notes } = Astro.props;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);
---

<Layout title={`${t.nav.notes} · ${tagName} | ${config.site.title}`}>
  <Header />

  <Breadcrumb />

  <Main
    pageTitle={`${t.nav.notes} · ${tagName}`}
    pageDesc={`${t.pages.notesTagDesc} "${tagName}".`}
  >
    <NoteTimeline {notes} />
  </Main>

  <Footer />
</Layout>
