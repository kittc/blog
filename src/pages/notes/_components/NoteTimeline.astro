---
import type { CollectionEntry } from "astro:content";
import dayjs from "dayjs";
import utc from "dayjs/plugin/utc";
import timezone from "dayjs/plugin/timezone";
import NoteCard from "./NoteCard.astro";
import { resolveTimezone } from "@/utils/resolveTimezone";
import config from "@/config";

dayjs.extend(utc);
dayjs.extend(timezone);

type Props = {
  /** Notes sorted newest first. */
  notes: CollectionEntry<"notes">[];
};

const { notes } = Astro.props;

const locale = Astro.currentLocale ?? config.site.lang;

type Group = {
  key: string;
  label: string;
  notes: CollectionEntry<"notes">[];
};

// Notes arrive newest-first, so notes sharing a day are always adjacent.
const groups: Group[] = [];
for (const note of notes) {
  const tz = resolveTimezone(note.data.timezone ?? config.site.timezone);
  const key = dayjs(note.data.pubDatetime).tz(tz).format("YYYY-MM-DD");
  const current = groups.at(-1);

  if (current?.key === key) {
    current.notes.push(note);
    continue;
  }

  groups.push({
    key,
    label: new Intl.DateTimeFormat(locale, {
      year: "numeric",
      month: "long",
      day: "numeric",
      timeZone: tz,
    }).format(note.data.pubDatetime),
    notes: [note],
  });
}
---

<div>
  {
    groups.map(group => (
      <section class="mb-10">
        <h2 class="text-muted-foreground mb-4 text-sm font-medium tracking-wide">
          {group.label}
          <span class="ms-1 opacity-60">· {group.notes.length}</span>
        </h2>
        <ol class="border-border ms-1 border-s border-dashed ps-5">
          {group.notes.map(note => (
            <NoteCard {note} />
          ))}
        </ol>
      </section>
    ))
  }
</div>
