---
import { render, type CollectionEntry } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import dayjs from "dayjs";
import utc from "dayjs/plugin/utc";
import timezone from "dayjs/plugin/timezone";
import { slugifyStr } from "@/utils/slugify";
import { resolveTimezone } from "@/utils/resolveTimezone";
import config from "@/config";

dayjs.extend(utc);
dayjs.extend(timezone);

type Props = {
  note: CollectionEntry<"notes">;
};

const { note } = Astro.props;

const { Content } = await render(note);
const { pubDatetime, timezone: noteTimezone, tags } = note.data;

const locale = Astro.currentLocale ?? config.site.lang;

const published = dayjs(pubDatetime).tz(
  resolveTimezone(noteTimezone ?? config.site.timezone)
);

// The collection id is the filename stem, so it is stable across rebuilds.
const anchorId = `n-${note.id}`;
---

{
  /*
  One continuous line: body, then time, then tags, all inline. Only the last
  paragraph becomes inline so multi-paragraph notes keep their breaks and the
  metadata still trails the final sentence.
*/
}
<li id={anchorId} class="relative scroll-mt-6 py-2.5">
  <span
    aria-hidden="true"
    class="bg-accent/60 absolute -inset-s-6 top-5 size-2 rounded-full"></span>

  <div
    class="app-prose max-w-none [&>*:first-child]:mt-0 [&>*:last-child]:mb-0 [&>p:last-of-type]:inline"
  >
    <Content />

    <time
      datetime={published.toISOString()}
      class="text-muted-foreground ms-4 text-sm whitespace-nowrap tabular-nums"
    >
      {published.format("HH:mm")}
    </time>

    {
      tags.map(tag => (
        <a
          href={getRelativeLocaleUrl(locale, `notes/tags/${slugifyStr(tag)}/`)}
          class="border-foreground hover:border-accent hover:text-accent focus-visible:text-accent ms-3 border-b-2 border-dashed text-sm whitespace-nowrap"
        >
          #{tag}
        </a>
      ))
    }
  </div>
</li>
