---
import { render, type CollectionEntry } from "astro:content";
import IconShare from "@/assets/icons/IconShare.svg";
import Datetime from "@/components/Datetime.astro";
import Tag from "@/components/Tag.astro";
import { useTranslations } from "@/i18n";
import { slugifyStr } from "@/utils/slugify";
import config from "@/config";

type Props = {
  note: CollectionEntry<"notes">;
};

const { note } = Astro.props;

const { Content } = await render(note);
const { pubDatetime, timezone, tags } = note.data;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

// The collection id is the filename stem, so it is stable across rebuilds.
const anchorId = `n-${note.id}`;
---

<li id={anchorId} class="relative my-7 scroll-mt-6">
  <span
    aria-hidden="true"
    class="bg-accent/60 absolute -inset-s-6 top-2.5 size-2 rounded-full"></span>

  <div class="flex items-center gap-2">
    <Datetime
      {pubDatetime}
      {timezone}
      format="HH:mm"
      showIcon={false}
      class="text-sm"
    />
    <button
      type="button"
      class="text-muted-foreground hover:text-accent focus-visible:text-accent inline-flex items-center gap-1 text-xs opacity-70 transition-opacity hover:opacity-100 focus-visible:opacity-100"
      data-copy-link={anchorId}
      data-copied={t.post.shareCopied}
      data-failed={t.post.shareCopyFailed}
      title={t.post.copyLink}
      aria-label={t.post.copyLink}
    >
      <IconShare class="size-3.5" aria-hidden="true" />
    </button>
  </div>

  <div class="app-prose mt-2 max-w-none">
    <Content />
  </div>

  {
    tags.length > 0 && (
      <ul class="mt-3 flex flex-wrap gap-x-4 gap-y-2">
        {tags.map(tag => (
          <Tag
            tag={slugifyStr(tag)}
            tagName={tag}
            size="sm"
            basePath="notes/tags"
            transition={false}
          />
        ))}
      </ul>
    )
  }
</li>
