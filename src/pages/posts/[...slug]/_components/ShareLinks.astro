---
import IconShare from "@/assets/icons/IconShare.svg";
import { useTranslations } from "@/i18n";
import config from "@/config";

type Props = {
  /** Post title, copied to the clipboard together with the URL. */
  title: string;
};

const { title } = Astro.props;
const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);
---

<div class="my-8 flex flex-col items-center gap-1" data-pagefind-ignore>
  <button
    id="share-post-btn"
    type="button"
    class="border-border hover:border-accent hover:text-accent inline-flex items-center gap-1.5 rounded border border-dashed px-3 py-1.5 text-sm transition-colors"
    data-share-title={title}
    data-label-copied={t.post.shareCopied}
    data-label-failed={t.post.shareCopyFailed}
  >
    <IconShare class="inline-block size-4" aria-hidden="true" />
    {t.post.share}
  </button>

  <!-- Reserves its own height so showing the hint doesn't shift the layout. -->
  <span
    id="share-toast"
    role="status"
    aria-live="polite"
    class="text-muted-foreground h-5 text-sm opacity-0 transition-opacity duration-200 motion-reduce:transition-none"
  ></span>
</div>

<script>
  const TOAST_DURATION = 1800;

  /**
   * Copies text, falling back to a hidden textarea when the async Clipboard
   * API is unavailable (insecure context or older browsers).
   */
  async function copyToClipboard(text: string): Promise<boolean> {
    if (navigator.clipboard && window.isSecureContext) {
      try {
        await navigator.clipboard.writeText(text);
        return true;
      } catch {
        // Permission denied or API blocked — try the legacy path below.
      }
    }

    const textarea = document.createElement("textarea");
    textarea.value = text;
    textarea.setAttribute("readonly", "");
    textarea.style.position = "fixed";
    textarea.style.top = "-9999px";
    textarea.style.opacity = "0";
    document.body.append(textarea);
    textarea.select();

    let copied = false;
    try {
      copied = document.execCommand("copy");
    } catch {
      copied = false;
    }
    textarea.remove();
    return copied;
  }

  function setupShare() {
    const button = document.querySelector<HTMLButtonElement>("#share-post-btn");
    if (!button || button.dataset.bound === "true") return;
    button.dataset.bound = "true";

    const toast = document.getElementById("share-toast");
    let hideTimer: number | undefined;
    let clearTimer: number | undefined;

    button.addEventListener("click", async () => {
      const shareTitle = button.dataset.shareTitle ?? document.title;
      const copied = await copyToClipboard(`${shareTitle}\n${location.href}`);
      if (!toast) return;

      const message = copied
        ? (button.dataset.labelCopied ?? "Copied")
        : (button.dataset.labelFailed ?? "Copy failed");

      window.clearTimeout(hideTimer);
      window.clearTimeout(clearTimer);
      toast.textContent = message;
      toast.classList.remove("opacity-0");
      toast.classList.add("opacity-100");

      hideTimer = window.setTimeout(() => {
        toast.classList.remove("opacity-100");
        toast.classList.add("opacity-0");
        // Clear after the fade so screen readers don't repeat stale text.
        clearTimer = window.setTimeout(() => {
          if (toast.textContent === message) toast.textContent = "";
        }, 200);
      }, TOAST_DURATION);
    });
  }

  setupShare();
  document.addEventListener("astro:page-load", setupShare);
</script>
